# Copy to .env and fill in. Never commit .env.
# In production these values come from a secrets manager (AWS Secrets
# Manager / Vault / Doppler) injected as environment variables — the files
# and code never hold real secrets.

# Postgres connection string (password included → treat as a secret).
# Must match POSTGRES_PASSWORD below — dotenv does not expand ${VARS}, so this
# is spelled out literally rather than referencing POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/octaraa

# Docker Postgres password, read by docker-compose.yml (use a strong password
# in production; keep it identical to the password embedded in DATABASE_URL above).
POSTGRES_PASSWORD=postgres

# Standard 5-field cron expression the scheduler re-syncs every linked
# account on. Default: every 6 hours. Use "*/1 * * * *" (every minute) for
# fast local testing.
SYNC_CRON_PATTERN=0 */6 * * *

# --- tuning (all optional, defaults shown) ---
SYNC_MAX_ATTEMPTS=4
SYNC_RETRY_BASE_MS=500
SYNC_RETRY_MAX_MS=8000

# Backoff for retrying a whole FAILED account sooner than the next cron
# tick: 1 minute base, capped at 6 hours (never worse than just waiting for
# the next tick). Same jittered exponential formula as page-level retry.
ACCOUNT_RETRY_BASE_MS=60000
ACCOUNT_RETRY_MAX_MS=21600000

# HTTP port for the Express app (health check, manual sync trigger, status).
PORT=3000
